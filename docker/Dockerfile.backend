# ========================================================
# EduFast Backend Dockerfile (Node.js + Express + SQLite)
# ========================================================

FROM node:20-bookworm-slim

# Install system dependencies needed for native modules (sqlite3) and Puppeteer/OCR
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    make \
    g++ \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install backend dependencies first for efficient layer caching
COPY backend/package*.json ./
RUN npm install --omit=dev

# Copy backend application source
COPY backend/ ./

# Create directories for persistent SQLite database and user uploads
RUN mkdir -p database uploads

# Environment variables
ENV NODE_ENV=production
ENV PORT=5000

# Expose API and WebSocket port
EXPOSE 5000

# Healthcheck
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:5000/api/health || exit 1

CMD ["node", "server.js"]
